# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Node environment
NODE_ENV=development

# Server port
PORT=3000

# Process type (for development - can run both or either)
# Set API_ONLY=true to run only the API process
# Set WORKER_ONLY=true to run only the worker process
# Leave both false to run both (not recommended for production)
API_ONLY=false
WORKER_ONLY=false

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================

# Default: Postgres in Docker on same host (see docker/local/ + docs/local-postgres.md)
DATABASE_URL=postgresql://crypto:crypto_local_dev@127.0.0.1:5432/chuyen_gia?schema=public
DIRECT_URL=postgresql://crypto:crypto_local_dev@127.0.0.1:5432/chuyen_gia?schema=public

# Optional: max connections per Node process for Prisma (PM2 runs api + worker).
# Defaults to 1 in production when the URL has no connection_limit. Override if your Postgres plan allows more.
# PRISMA_CONNECTION_LIMIT=1

# Worker leader lock key (fixed integer for preventing duplicate cron execution)
# Change this to a different integer if you have multiple worker instances
WORKER_LEADER_LOCK_KEY=12345

# Worker scheduler tuning
# Price sync frequency in milliseconds (minimum recommended: 5000)
PRICE_UPDATE_INTERVAL_MS=30000
# Validate expired predictions (cron format)
PREDICTION_VALIDATION_CRON=0 * * * *
# Daily maintenance tick (cron format)
DAILY_MAINTENANCE_CRON=0 3 * * *
# Snapshot interval for account/testnet account snapshots (cron format)
SNAPSHOT_CRON=*/15 * * * *
# Skip snapshot rows unless equity/balance/positions changed materially (ms)
SNAPSHOT_MIN_INTERVAL_MS=900000
# Price history writes (prediction validation fallback) — not every price tick
PRICE_HISTORY_INTERVAL_MS=300000
# Dashboard read cache TTLs (ms)
DASHBOARD_READ_CACHE_TTL_MS=30000
DASHBOARD_EVENTS_CACHE_TTL_MS=20000
DASHBOARD_WARMUP_CACHE_TTL_MS=60000
ACCOUNT_BALANCE_CACHE_TTL_MS=20000
MARKET_READ_CACHE_TTL_MS=25000
# Scheduler heartbeat DB persist throttle (ms)
SCHEDULER_HEARTBEAT_PERSIST_INTERVAL_MS=120000
# Open position mark/unrealized DB writes (ms)
POSITION_MARK_PERSIST_INTERVAL_MS=300000
# Retention in days for market history tables
RETENTION_DAYS_PRICE_HISTORY=30
RETENTION_DAYS_OHLCV=90

# ============================================
# GROQ API CONFIGURATION
# ============================================

# Levels adapter (optional): when primary Groq output fails min SL distance (Step 5a), or fails
# min R:R from prices with SL already valid (Step 5b), one focused call using GROQ_API_KEY_2 only.
# Step 5a: widens SL + TP. Step 5b: adjusts TP only (SL fixed). Same enable flag for both.
# GROQ_LEVELS_ADAPTER_ENABLED=false
# Optional model for adapter only (defaults to GROQ_MODEL_PRIMARY or llama-4-scout)
# GROQ_MODEL_LEVELS_ADAPTER=meta-llama/llama-4-scout-17b-16e-instruct

# Groq API Keys (supports multiple keys for fallback on rate limits)
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
# Fallback to single key if only one is available
GROQ_API_KEY=your_groq_api_key_here
CACHE_TTL_MINUTES=20
CRON_SCHEDULE=*/15 * * * *

# CORS Configuration
# Comma-separated list of allowed origins for production
# Example: ALLOWED_ORIGINS=https://my-app.vercel.app,https://mydomain.com
ALLOWED_ORIGINS=https://my-app.vercel.app,https://mydomain.com

# Symbol Configuration (BTC-only trading - Updated 17/04/2026)
ENABLED_SYMBOLS=BTC
# Worker candle timeframe used when persisting price sync data
WORKER_OHLCV_TIMEFRAME=15m
# On worker start: backfill OHLCV from Binance when DB count < warmup target (default on)
# V3_OHLCV_BACKFILL_ON_START=false
# Warmup bar targets (dashboard); backfill uses these per TF
# V3_WARMUP_5M=2000
# V3_WARMUP_15M=1000
# V3_WARMUP_1H=500
# Enable worker testnet state sync (active when BINANCE_ENABLED=true)
WORKER_ENABLE_TESTNET_SYNC=true
MAX_POSITIONS_PER_SYMBOL=1
# Max combined USD notional: open positions + pending limit orders (fallback when % unset)
MAX_TOTAL_EXPOSURE_USD=2000

# Pending limit lifecycle (TTL + price drift cancel on Binance + DB)
# PENDING_ORDER_LIFECYCLE_ENABLED=false
# PENDING_ORDER_LIFECYCLE_CRON=*/5 * * * *
# PENDING_ORDER_TTL_HOURS_5M=4
# PENDING_ORDER_TTL_HOURS_15M=6
# PENDING_ORDER_TTL_HOURS_1H=24
# PENDING_ORDER_TTL_HOURS_4H=48
# PENDING_ORDER_TTL_MAX_HOURS=48
# PENDING_ORDER_DRIFT_PCT=0.008
# LLM review of unfilled limits (hold/cancel/modify) — runs after TTL/drift pass
# PENDING_ORDER_REVIEW_ENABLED=false
# PENDING_ORDER_REVIEW_MIN_CONFIDENCE=0.7

# One-off testnet PnL backfill (npm run testnet:backfill-pnl)
# BACKFILL_SYMBOL=BTC
# BACKFILL_METHOD_ID=kim_nghia

# PnL+ P0: cap exposure as fraction of wallet (overrides flat USD when set)
# MAX_EXPOSURE_PCT_OF_EQUITY=0.15
# MAX_CONSECUTIVE_LOSSES=2
# CONSECUTIVE_LOSS_COOLDOWN_HOURS=4

# Position monitor (worker, every minute). SL/TP on Binance remain primary exit path.
# POSITION_MONITOR_ENABLED=false          # disable all monitor actions
# POSITION_MONITOR_ALLOW_REDUCE=true      # default OFF in code — must set true to enable 50% reduce
# POSITION_MONITOR_ALLOW_EXIT=true        # default OFF — set true to allow monitor full exit
# POSITION_MONITOR_DEFER_TO_EXCHANGE_SLTP=false  # force monitor actions even when SL/TP orders exist
# POSITION_MONITOR_MIN_MINUTES=30         # min age before monitor may act
# POSITION_MONITOR_MIN_PNL_PCT=0.5        # min |unrealized %| for discretionary reduce
# POSITION_MONITOR_PRECISION_SKIP_MIN=30  # cooldown after failed close (minutes)

# V3 LLM / entries (5m stack — see docs/v3-5m-reset-plan.md)
# V3_SIGNAL_GATE_TIMEFRAMES=5m,15m,1h
# V3_TF_PRIORITY=15m,1h,5m
# V3_ENTRY_TF_PRIORITY=15m,1h,5m
# V3_LTF_ALIGN_REGIME_HTF=1h
# V3_REGIME_TREND_MIN_1H=0.06
# V3_REGIME_TREND_MIN_15M=0.08
# V3_REGIME_TREND_MIN_5M=0.10
# V3_BREAKOUT_REGIME_BYPASS=true
# V3_TEST_FAST_SAMPLE=true
# V3_LLM_DISPATCH_CRON=1,6,11,16,21,26,31,36,41,46,51,56 * * * *
# SIGNAL_GATE_CACHE_TTL_MS=300000
# V3_REQUIRE_HTF_TREND=1h
# V3_ALLOWED_REGIMES=trend                # comma-separated: trend,range,chop (default: trend)
# V3_BLOCK_RANGE_ENTRIES=false            # allow entries in range/chop (default: block)
# V3_MIN_LLM_CONFIRM_CONFIDENCE=0.75      # LLM must confirm at this confidence to trade
# PHANTOM_REOPEN_ENABLED=true             # reopen DB after phantom SL/TP close (default: false)

# Prediction Reversal Check
PREDICTION_REVERSAL_ENABLED=true
PREDICTION_REVERSAL_CONFIDENCE=80

# ============================================
# CONFIDENCE THRESHOLDS
# ============================================

# AI Position Management Confidence Thresholds
# Actions only execute if AI confidence >= threshold
ICT_CONFIDENCE_THRESHOLD=0.70
KIM_NGHIA_CONFIDENCE_THRESHOLD=0.82
AUTO_ENTRY_CONFIDENCE_THRESHOLD=0.80

# Session Timing (ICT: focus on high-liquidity sessions)
ALLOWED_SESSIONS=london,ny_killzone
# London: 07:00-10:00 UTC
# NY Killzone: 12:00-15:00 UTC

# Partial Take Profits (ICT: take profits in stages)
PARTIAL_TP_ENABLED=true
PARTIAL_TP_RATIOS=0.5,0.5
PARTIAL_TP_RR_LEVELS=1.0,2.0

# Trailing Stop (ICT: move SL to breakeven after TP1)
TRAILING_STOP_ENABLED=true
TRAIL_AFTER_RR=1.0
TRAIL_DISTANCE_PCT=0.5

# API Rate Limiting
# CoinGecko free tier: ~10-50 calls/minute
# Binance public API: 1200 calls/minute
# Paper trading uses Binance real-time API (no rate limit issues)
COINGECKO_MIN_DELAY_MS=2000

# Binance Futures Configuration (REST API)
# Supports both Demo Trading and Mainnet
# Switch between them by changing BINANCE_BASE_URL

# Enable/disable Binance Futures integration
# Set to 'true' to enable trading
# Default: false (disabled)

# Binance API Base URL
# Demo Trading: https://demo-fapi.binance.com
# Mainnet: https://fapi.binance.com
# Default: demo-fapi.binance.com (Demo Trading)
BINANCE_BASE_URL=https://demo-fapi.binance.com
# User stream + reconciliation on worker (default). Set false to run WS on API process instead.
# BINANCE_USER_STREAM_ON_WORKER=true

# Binance API Key
# Get your API key from: https://www.binance.com/en/my/settings/api-management
# For Demo Trading: https://testnet.binancefuture.com/
# Go to API Management → Create API
# Required only if BINANCE_ENABLED=true
BINANCE_API_KEY=your_binance_api_key

# Binance API Secret Key
# Get your Secret Key from the same place as API Key
# Required only if BINANCE_ENABLED=true
# Keep this secret and never commit to version control
BINANCE_API_SECRET=your_binance_secret_key

# Trading symbol
# Currently supports: BTCUSDT only
# Future enhancement: Multi-symbol support (ETHUSDT, SOLUSDT, etc.)
BINANCE_SYMBOL=BTCUSDT

# Leverage multiplier for trading
# Range: 1-125 (Binance Futures limits)
# Recommended: 1-3 for risk management
# Higher leverage = higher risk and potential returns
# Default: 20
BINANCE_LEVERAGE=20

# Request window for signed requests (milliseconds)
# Binance uses this to prevent replay attacks
# Default: 5000 (5 seconds)
BINANCE_RECV_WINDOW=5000
# ============================================
# TELEGRAM BOT (optional)
# ============================================
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_IDS=your_chat_id
# TELEGRAM_ALLOWED_USER_IDS=
# trades_only = mở/đóng lệnh testnet only; verbose = thêm scan/LLM (không khuyến nghị)
# TELEGRAM_NOTIFY_LEVEL=trades_only
# TELEGRAM_DAILY_REPORT_CRON=0_21_*_*_*
#   Use underscores (PM2 splits on spaces). Means: 0 21 * * * at Asia/Ho_Chi_Minh
# TELEGRAM_POLLING_ENABLED=true
#   false (default): notify + daily report only; getUpdates free for manual debug
#   true: worker runs /lenh /show command polling (exclusive — blocks other getUpdates)

MIN_SIGNAL_GRADE=B
# Align with playbook grades: B=0.70, A=0.85 (0.8 blocks all B setups)
MIN_SIGNAL_CONFIDENCE=0.7

# Min distance entry → stop loss (fraction of price). 0.004 = 0.4% (5m stack); 0.005 = 0.5% (15m+)
# PnL+: do not go below 0.004 on BTC — tighter stops get stopped by 5m noise before edge plays out
MIN_SL_DISTANCE_PERCENT=0.004