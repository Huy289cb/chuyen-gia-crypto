# ============================================
# MAINNET VPS — copy → backend/.env
# Giữ cấu hình giống develop VPS; chỉ điền các key có comment [ĐIỀN]
# Plan: docs/plan/mainnet-openrouter-vps-plan.md
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3000
API_ONLY=false
WORKER_ONLY=false

# ============================================
# DATABASE (Postgres Docker trên VPS mới — DB riêng, không share develop)
# ============================================
DATABASE_URL=postgresql://crypto:crypto_local_dev@127.0.0.1:5432/chuyen_gia?schema=public
DIRECT_URL=postgresql://crypto:crypto_local_dev@127.0.0.1:5432/chuyen_gia?schema=public

WORKER_LEADER_LOCK_KEY=12346

PRICE_UPDATE_INTERVAL_MS=30000
PREDICTION_VALIDATION_CRON=0 * * * *
DAILY_MAINTENANCE_CRON=0 3 * * *
SNAPSHOT_CRON=*/15 * * * *
SNAPSHOT_MIN_INTERVAL_MS=900000
PRICE_HISTORY_INTERVAL_MS=300000
DASHBOARD_READ_CACHE_TTL_MS=30000
DASHBOARD_EVENTS_CACHE_TTL_MS=20000
DASHBOARD_WARMUP_CACHE_TTL_MS=60000
ACCOUNT_BALANCE_CACHE_TTL_MS=20000
MARKET_READ_CACHE_TTL_MS=25000
SCHEDULER_HEARTBEAT_PERSIST_INTERVAL_MS=120000
POSITION_MARK_PERSIST_INTERVAL_MS=300000
RETENTION_DAYS_PRICE_HISTORY=30
RETENTION_DAYS_OHLCV=60

# ============================================
# LLM — MAIN: OpenRouter Scout primary (khác develop dùng Groq)
# ============================================
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-...                                    # [ĐIỀN] key OpenRouter thật (~10u)
OPENROUTER_DISPATCH_MODEL=meta-llama/llama-4-scout
OPENROUTER_DISPATCH_FALLBACK_ENABLED=true
OPENROUTER_HTTP_REFERER=https://download-money-moi.vercel.app
OPENROUTER_APP_TITLE=chuyen-gia-crypto-main

# Levels adapter — vẫn dùng Groq key2 (giống develop)
GROQ_LEVELS_ADAPTER_ENABLED=true
GROQ_MODEL_LEVELS_ADAPTER=openai/gpt-oss-120b
GROQ_API_KEY_2=gsk_...                                             # [ĐIỀN] hoặc copy key2 develop
# Groq dispatch fallback (optional khi OpenRouter fail)
GROQ_API_KEY_1=gsk_...                                             # [ĐIỀN] optional
GROQ_MODEL_PRIMARY=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile,qwen/qwen3-32b,qwen/qwen3.6-27b,llama-3.1-8b-instant

CEREBRAS_API_KEY=csk_...                                           # [ĐIỀN] optional fallback

CACHE_TTL_MINUTES=20
CRON_SCHEDULE=*/15 * * * *

ALLOWED_ORIGINS=https://download-money-moi.vercel.app

# ============================================
# RISK / SIZING (giống develop)
# Wallet thật ~40-50 USDT; notional policy $200–$2000 qua leverage
# ============================================
RISK_PER_TRADE_PERCENT=1
MIN_CONFIDENCE_THRESHOLD=80
MIN_RR_RATIO=3
PRICE_UPDATE_INTERVAL=30
MAX_CONSECUTIVE_LOSSES=2
CONSECUTIVE_LOSS_COOLDOWN_HOURS=2

ENABLED_SYMBOLS=BTC
WORKER_OHLCV_TIMEFRAME=15m
WORKER_ENABLE_PAPER_TRADING_SYNC=true
WORKER_ENABLE_TESTNET_SYNC=true
MAX_POSITIONS_PER_SYMBOL=1
MAX_TOTAL_EXPOSURE_USD=2000
BINANCE_MIN_ORDER_NOTIONAL_USD=200
MIN_SIGNAL_GRADE=A
MIN_SIGNAL_CONFIDENCE=0.75
MIN_SL_DISTANCE_PERCENT=0.008

# Position monitor
POSITION_MONITOR_ALLOW_REDUCE=false
POSITION_MONITOR_ALLOW_EXIT=false
POSITION_MONITOR_DEFER_TO_EXCHANGE_SLTP=true
POSITION_MONITOR_MIN_MINUTES=30
POSITION_MONITOR_MIN_PNL_PCT=0.5
POSITION_MONITOR_PRECISION_SKIP_MIN=30

# ============================================
# V3 SIGNAL GATE + P0 POLICY (giống develop)
# ============================================
V3_OHLCV_BACKFILL_ON_START=true
V3_SIGNAL_GATE_TIMEFRAMES=5m,15m,1h
V3_TF_PRIORITY=15m,1h,5m
V3_ENTRY_TF_PRIORITY=15m,1h,5m
V3_REQUIRE_5M_HTF_CONFIRM=true
V3_LTF_ALIGN_REGIME_HTF=1h
V3_LLM_DISPATCH_CRON=1,6,11,16,21,26,31,36,41,46,51,56 * * * *
SIGNAL_GATE_CACHE_TTL_MS=300000
V3_REQUIRE_HTF_TREND=1h
V3_HTF_TREND_ALT=15m
V3_HTF_FLEX_LTF_ONLY=true
V3_ALLOWED_REGIMES=trend
V3_REGIME_TREND_MIN_1H=0.06
V3_REGIME_TREND_MIN_15M=0.08
V3_REGIME_TREND_MIN_5M=0.10
V3_REGIME_STRONG_TREND_MIN=0.25
V3_BREAKOUT_REGIME_BYPASS=true
V3_BLOCK_RANGE_ENTRIES=true
V3_MIN_LLM_CONFIRM_CONFIDENCE=0.75
PHANTOM_REOPEN_ENABLED=false

PREDICTION_REVERSAL_ENABLED=true
PREDICTION_REVERSAL_CONFIDENCE=80

ICT_CONFIDENCE_THRESHOLD=0.70
KIM_NGHIA_CONFIDENCE_THRESHOLD=0.82
AUTO_ENTRY_CONFIDENCE_THRESHOLD=0.80

ALLOWED_SESSIONS=london,ny_killzone
PARTIAL_TP_ENABLED=true
PARTIAL_TP_RATIOS=0.5,0.5
PARTIAL_TP_RR_LEVELS=1.0,2.0
TRAILING_STOP_ENABLED=true
TRAIL_AFTER_RR=1.0
TRAIL_DISTANCE_PCT=0.5

COINGECKO_MIN_DELAY_MS=2000

# ============================================
# BINANCE MAINNET (khác develop: fapi.binance.com + key mainnet)
# ============================================
BINANCE_ENABLED=true
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_API_KEY=...                                                # [ĐIỀN] mainnet Futures API key
BINANCE_API_SECRET=...                                             # [ĐIỀN] mainnet secret (no withdraw)
BINANCE_SYMBOL=BTCUSDT
BINANCE_LEVERAGE=50
BINANCE_RECV_WINDOW=5000

# Mainnet safety — Phase A shadow: LIVE=false; Phase B: bật 2 dòng dưới
MAINNET_LIVE_TRADING_ENABLED=false
# MAINNET_TRADING_ACK=I_UNDERSTAND_REAL_MONEY
MAINNET_MAX_TOTAL_EXPOSURE_USD=2000
MAINNET_MAX_LEVERAGE=50
MAINNET_MAX_RISK_PER_TRADE_PERCENT=1

# ============================================
# TELEGRAM — bot + group MỚI (không dùng chung develop)
# ============================================
# 1. @BotFather → /newbot
# 2. Tạo group/channel riêng, add bot
# 3. Gửi tin nhắn → curl getUpdates lấy chat_id
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=...                                             # [ĐIỀN] bot mainnet mới
TELEGRAM_CHAT_IDS=-100...                                          # [ĐIỀN] group/channel id
TELEGRAM_ALLOWED_USER_IDS=1289969972                               # [ĐIỀN] telegram user id của bạn
TELEGRAM_NOTIFY_LEVEL=trades_only
TELEGRAM_DAILY_REPORT_CRON=0_21_*_*_*
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_AI_ENABLED=true

# ============================================
# CURSOR SDK (optional — tắt hoặc điền key)
# ============================================
CURSOR_AGENT_ENABLED=false
# CURSOR_API_KEY=crsr_...
# CURSOR_AGENT_MODEL=composer-2.5
# CURSOR_AGENT_REPO_URL=https://github.com/Huy289cb/chuyen-gia-crypto
# CURSOR_AGENT_BASE_BRANCH=main
# CURSOR_CHAT_ENABLED=false
